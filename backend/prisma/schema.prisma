generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RolCuenta {
  ADMINISTRADOR
  FUNCIONARIO
  EGRESADO
}

enum CargoFuncionario {
  JEFE_CARRERA
  SECRETARIA
  COORDINADOR
  DOCENTE
  OTRO
}

enum RolFuncionario {
  ADMINISTRADOR
  GESTOR
  LECTOR
}

enum EstadoPerfil {
  INCOMPLETO
  ACTIVO
  INACTIVO
}

enum TipoCorreo {
  PERSONAL
  INSTITUCIONAL
  LABORAL
}

enum TipoTelefono {
  MOVIL
  FIJO
  LABORAL
}

enum EstadoLaboral {
  EMPLEADO
  INDEPENDIENTE
  DESEMPLEADO
  ESTUDIANDO
  OTRO
}

enum RangoSueldo {
  MENOS_500K
  ENTRE_500K_1M
  ENTRE_1M_1_5M
  ENTRE_1_5M_2M
  ENTRE_2M_3M
  MAS_3M
  NO_INFORMA
}

enum TipoOferta {
  EMPLEO
  PRACTICA
  PART_TIME
  FREELANCE
}

enum OrigenOferta {
  INTERNA
  EMPRESA
  EXTERNA
}

enum CanalComunicacion {
  PORTAL
  CORREO
  PORTAL_Y_CORREO
}

model cuenta {
  id_cuenta               Int       @id @default(autoincrement())
  correo                  String    @unique @db.VarChar(150)
  contrasena_hash         String    @db.VarChar(255)
  rol                     RolCuenta
  fecha_verificacion      DateTime?
  // true cuando la Secretaría creó la cuenta con una contraseña inicial que el egresado debe cambiar.
  debe_cambiar_contrasena Boolean   @default(false)
  activo                  Boolean   @default(true)
  fecha_creacion          DateTime  @default(now())

  funcionario       funcionario?
  egresado          egresado?
  movimientos_autor movimiento_perfil[]
  comunicaciones    comunicacion[]

  @@map("cuenta")
}

model funcionario {
  id_funcionario   Int              @id @default(autoincrement())
  id_cuenta        Int              @unique
  nombres          String           @db.VarChar(100)
  apellido_paterno String           @db.VarChar(60)
  apellido_materno String?          @db.VarChar(60)
  cargo            CargoFuncionario
  rol_funcionario  RolFuncionario

  cuenta         cuenta           @relation(fields: [id_cuenta], references: [id_cuenta])
  ofertas        oferta_laboral[]
  comunicaciones comunicacion[]

  @@map("funcionario")
}

model especialidad {
  id_especialidad Int    @id @default(autoincrement())
  nombre          String @unique @db.VarChar(120)

  egresados      egresado[]
  comunicaciones comunicacion[]

  @@map("especialidad")
}

model egresado {
  id_egresado         Int          @id @default(autoincrement())
  id_cuenta           Int?         @unique
  id_especialidad     Int?
  rut                 String       @unique @db.VarChar(12)
  nombres             String       @db.VarChar(100)
  apellido_paterno    String       @db.VarChar(60)
  apellido_materno    String?      @db.VarChar(60)
  ciudad_residencia   String?      @db.VarChar(100)
  anio_ingreso        Int?
  anio_egreso         Int?
  estado_perfil       EstadoPerfil @default(INCOMPLETO)
  fecha_creacion      DateTime     @default(now())
  fecha_actualizacion DateTime     @updatedAt

  cuenta       cuenta?             @relation(fields: [id_cuenta], references: [id_cuenta])
  especialidad especialidad?       @relation(fields: [id_especialidad], references: [id_especialidad])
  correos      egresado_correo[]
  telefonos    egresado_telefono[]
  situaciones  situacion_laboral[]
  movimientos  movimiento_perfil[]

  @@index([apellido_paterno])
  @@index([anio_egreso])
  @@map("egresado")
}

model egresado_correo {
  id_correo    Int        @id @default(autoincrement())
  id_egresado  Int
  correo       String     @db.VarChar(150)
  tipo         TipoCorreo @default(PERSONAL)
  es_principal Boolean    @default(false)

  egresado egresado @relation(fields: [id_egresado], references: [id_egresado], onDelete: Cascade)

  @@unique([id_egresado, correo])
  @@map("egresado_correo")
}

model egresado_telefono {
  id_telefono  Int          @id @default(autoincrement())
  id_egresado  Int
  telefono     String       @db.VarChar(20)
  tipo         TipoTelefono @default(MOVIL)
  es_principal Boolean      @default(false)

  egresado egresado @relation(fields: [id_egresado], references: [id_egresado], onDelete: Cascade)

  @@unique([id_egresado, telefono])
  @@map("egresado_telefono")
}

model situacion_laboral {
  id_situacion   Int           @id @default(autoincrement())
  id_egresado    Int
  estado_laboral EstadoLaboral
  empresa        String?       @db.VarChar(150)
  cargo          String?       @db.VarChar(120)
  rango_sueldo   RangoSueldo?
  fecha_inicio   DateTime?     @db.Date
  fecha_termino  DateTime?     @db.Date
  es_actual      Boolean       @default(true)

  egresado egresado @relation(fields: [id_egresado], references: [id_egresado], onDelete: Cascade)

  @@index([id_egresado, es_actual])
  @@map("situacion_laboral")
}

model movimiento_perfil {
  id_movimiento   Int      @id @default(autoincrement())
  id_egresado     Int
  id_cuenta_autor Int?
  campo           String   @db.VarChar(80)
  valor_anterior  String?  @db.VarChar(500)
  valor_nuevo     String?  @db.VarChar(500)
  fecha           DateTime @default(now())

  egresado egresado @relation(fields: [id_egresado], references: [id_egresado], onDelete: Cascade)
  autor    cuenta?  @relation(fields: [id_cuenta_autor], references: [id_cuenta])

  @@map("movimiento_perfil")
}

model oferta_laboral {
  id_oferta         Int          @id @default(autoincrement())
  id_funcionario    Int
  titulo            String       @db.VarChar(150)
  empresa           String       @db.VarChar(150)
  requisitos        String?      @db.Text
  tipo              TipoOferta
  origen            OrigenOferta
  url_postulacion   String?      @db.VarChar(255)
  correo_contacto   String?      @db.VarChar(150)
  fecha_publicacion DateTime     @default(now())
  fecha_cierre      DateTime?    @db.Date

  funcionario funcionario @relation(fields: [id_funcionario], references: [id_funcionario])

  @@map("oferta_laboral")
}

model comunicacion {
  id_comunicacion     Int               @id @default(autoincrement())
  id_funcionario      Int?
  id_cuenta_autor     Int
  titulo              String            @db.VarChar(150)
  contenido           String            @db.Text
  canal               CanalComunicacion @default(PORTAL)
  id_especialidad     Int?
  anio_egreso         Int?
  total_destinatarios Int               @default(0)
  fecha_publicacion   DateTime          @default(now())

  funcionario  funcionario?  @relation(fields: [id_funcionario], references: [id_funcionario])
  autor        cuenta        @relation(fields: [id_cuenta_autor], references: [id_cuenta])
  especialidad especialidad? @relation(fields: [id_especialidad], references: [id_especialidad])

  @@index([fecha_publicacion])
  @@map("comunicacion")
}
