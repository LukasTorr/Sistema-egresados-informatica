# Cadena de conexión a MySQL: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="mysql://root:tu_password@localhost:3306/sistema_egresados"

# Secreto para firmar los tokens JWT (cámbialo por algo largo y aleatorio)
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRES_IN="8h"

PORT=3000

# Cuenta administradora que crea el seed (npm run prisma:seed)
ADMIN_CORREO="admin@icci.cl"
ADMIN_CONTRASENA="Admin1234"
